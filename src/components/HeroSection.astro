---
import { withBase } from '../lib/paths';

const heroBackground = withBase('/uploads/indoor-sun-escape.jpg');
---

<section class="hero" style={`--hero-bg-image: url("${heroBackground}");`} aria-labelledby="hero-title">
	<nav class="nav" aria-label="Primary navigation">
		<a class="brand" href="#hero-title" aria-label="Endless Summer Simulator home">
			<span class="brand-mark" aria-hidden="true">☀</span>
			<span>Endless Summer Simulator</span>
		</a>
		<div class="nav-links">
			<a href="#features">Therapy</a>
			<a href="#pricing">Pricing</a>
			<a class="nav-cta" href="#book">Book heat</a>
		</div>
	</nav>

	<div class="hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Helsinki's first emotionally necessary fake beach</p>
			<h1 id="hero-title">Survive Finnish winter by pretending it never happened.</h1>
			<p class="lede">
				Our indoor tropical dome blasts 24-hour sunlight, heat, imported sand, and mild
				self-delusion for six months straight. Pay premium to experience what
				<span>"not wanting to die"</span> feels like in February.
			</p>
			<div class="hero-actions">
				<a class="button primary" href="#pricing">Choose your denial plan</a>
				<a class="button secondary" href="#features">Tour the fake coast</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 860px;
		padding: 24px clamp(18px, 4vw, 64px) 132px;
		background:
			linear-gradient(90deg, rgba(var(--ess-sand-rgb), 0.96) 0%, rgba(var(--ess-sand-rgb), 0.86) 36%, rgba(var(--ess-lagoon-rgb), 0.46) 68%, rgba(var(--ess-plum-rgb), 0.12) 100%),
			linear-gradient(180deg, rgba(var(--ess-lagoon-rgb), 0.52) 0%, rgba(var(--ess-sun-rgb), 0.08) 54%, rgba(var(--ess-lagoon-rgb), 0.92) 100%),
			var(--hero-bg-image) center / cover no-repeat;
		box-shadow: inset 0 -92px 110px rgba(var(--ess-lagoon-rgb), 0.9);
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(circle at 12% 20%, rgba(var(--ess-sand-rgb), 0.74), transparent 24rem),
			radial-gradient(circle at 76% 18%, rgba(var(--ess-sun-rgb), 0.28), transparent 24rem),
			linear-gradient(180deg, transparent 68%, var(--ess-lagoon) 100%);
		pointer-events: none;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		max-width: 1180px;
		margin: 0 auto 112px;
		padding: 12px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: rgba(var(--ess-sand-rgb), 0.64);
		backdrop-filter: blur(18px);
		box-shadow: var(--shadow-soft);
	}

	.brand,
	.nav-links {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 10px;
		padding-left: 8px;
		font-weight: 800;
		text-decoration: none;
		letter-spacing: -0.03em;
		color: var(--color-ink);
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--ess-sand), var(--ess-sun));
		color: var(--color-ink);
		box-shadow: 0 0 32px rgba(var(--ess-sun-rgb), 0.55);
	}

	.nav-links {
		gap: 8px;
	}

	.nav-links a {
		padding: 10px 14px;
		border-radius: 999px;
		color: var(--color-ink-muted);
		font-size: 0.94rem;
		font-weight: 700;
		text-decoration: none;
		transition: 180ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible {
		background: rgba(var(--ess-plum-rgb), 0.08);
		color: var(--color-ink);
		outline: none;
	}

	.nav-links .nav-cta {
		background: var(--color-ink);
		color: var(--color-on-dark);
	}

	.nav,
	.hero-grid {
		position: relative;
		z-index: 1;
	}

	.hero-grid {
		display: grid;
		max-width: 1180px;
		margin: 0 auto;
	}

	.hero-copy {
		max-width: 840px;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 18px;
		padding: 8px 12px;
		border: 1px solid rgba(var(--ess-sun-rgb), 0.45);
		border-radius: 999px;
		background: var(--color-accent-soft);
		color: var(--color-ink);
		font-weight: 800;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		font-size: 0.78rem;
		backdrop-filter: blur(10px);
	}

	.eyebrow::before {
		content: "";
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 18px var(--color-accent);
	}

	h1 {
		max-width: 840px;
		margin: 0;
		color: var(--color-ink);
		font-size: clamp(3.2rem, 8.4vw, 7.6rem);
		line-height: 0.88;
		letter-spacing: -0.085em;
		text-wrap: balance;
	}

	.lede {
		max-width: 680px;
		margin: 26px 0 0;
		color: var(--color-ink-muted);
		font-size: clamp(1.06rem, 1.8vw, 1.25rem);
		line-height: 1.7;
	}

	.lede span {
		color: var(--color-ink);
		font-weight: 900;
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 0.18em;
		text-underline-offset: 0.16em;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 34px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 0 22px;
		border-radius: 999px;
		font-weight: 900;
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translateY(-2px);
		outline: none;
	}

	.primary {
		background: linear-gradient(135deg, var(--ess-sand), var(--ess-sun) 68%, var(--ess-plum));
		color: var(--color-ink);
		box-shadow: 0 18px 48px rgba(var(--ess-sun-rgb), 0.35);
	}

	.secondary {
		border: 1px solid var(--color-border);
		background: rgba(var(--ess-sand-rgb), 0.58);
		color: var(--color-ink);
		backdrop-filter: blur(10px);
	}

	@media (max-width: 900px) {
		.hero {
			min-height: 760px;
		}

		.nav {
			align-items: flex-start;
			border-radius: 28px;
			margin-bottom: 86px;
		}

		.nav-links {
			flex-wrap: wrap;
			justify-content: flex-end;
		}
	}

	@media (max-width: 620px) {
		.hero {
			min-height: 720px;
			padding-inline: 14px;
			padding-top: 14px;
			padding-bottom: 104px;
			background-position: center top;
		}

		.nav {
			margin-bottom: 64px;
		}

		.brand span:last-child {
			max-width: 150px;
			line-height: 1.05;
		}

		.nav-links a:not(.nav-cta) {
			display: none;
		}

		.hero-actions .button {
			width: 100%;
		}
	}
</style>
