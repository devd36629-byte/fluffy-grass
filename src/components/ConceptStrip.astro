---
const concepts = [
	'January darkness enters through revolving door',
	'Artificial solarium sun apologizes for nothing',
	'Imported sand hides existential dread beautifully',
	'You leave smelling like coconut and questionable decisions',
];
---

<section class="strip" aria-label="How Endless Summer Simulator works">
	<div class="track">
		{concepts.concat(concepts).map((item) => (
			<span>{item}</span>
		))}
	</div>
</section>

<style>
	.strip {
		margin: -36px 0 0;
		padding: 0 clamp(14px, 4vw, 64px);
		overflow: hidden;
	}

	.track {
		display: flex;
		gap: 12px;
		max-width: 1180px;
		margin: 0 auto;
		padding: 12px;
		border: 1px solid var(--color-border);
		border-radius: 28px;
		background: rgba(var(--ess-sand-rgb), 0.46);
		backdrop-filter: blur(16px);
		box-shadow: var(--shadow-soft);
	}

	span {
		flex: 0 0 auto;
		padding: 12px 16px;
		border-radius: 999px;
		background: rgba(var(--ess-plum-rgb), 0.92);
		color: var(--color-on-dark);
		font-weight: 800;
		font-size: 0.92rem;
	}

	@media (max-width: 720px) {
		.track {
			overflow-x: auto;
			scroll-snap-type: x mandatory;
		}

		span {
			scroll-snap-align: start;
		}
	}
</style>
