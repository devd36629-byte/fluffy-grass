---
const features = [
	{
		title: 'Circadian Confusion Dome',
		description: 'A ceiling of industrial suns convinces your body that midnight is brunch and Tuesday is July.',
		icon: '🌞',
	},
	{
		title: 'Premium Heat Anxiety',
		description: 'Our patented +31°C air makes wool socks feel like a personal attack within minutes.',
		icon: '🔥',
	},
	{
		title: 'Snowproof Coconut Bar',
		description: 'Sip drinks with umbrellas while actual Helsinki becomes a grayscale documentary outside.',
		icon: '🍹',
	},
	{
		title: 'Seasonal Affective Upsell',
		description: 'For a small fee, staff will say “you look alive again” every time you enter the lagoon.',
		icon: '🧾',
	},
];
---

<section class="features" id="features" aria-labelledby="features-title">
	<div class="section-heading">
		<p class="kicker">The treatment Finnish doctors whisper about</p>
		<h2 id="features-title">Everything winter took from you, recreated indoors with alarming confidence.</h2>
	</div>

	<div class="grid">
		{features.map((feature) => (
			<article class="feature-card">
				<div class="icon" aria-hidden="true">{feature.icon}</div>
				<h3>{feature.title}</h3>
				<p>{feature.description}</p>
			</article>
		))}
	</div>
</section>

<style>
	.features {
		padding: 108px clamp(18px, 4vw, 64px) 40px;
	}

	.section-heading,
	.grid {
		max-width: 1180px;
		margin-inline: auto;
	}

	.section-heading {
		display: grid;
		grid-template-columns: 0.8fr 1.5fr;
		gap: 28px;
		align-items: end;
		margin-bottom: 32px;
	}

	.kicker {
		margin: 0;
		color: #ffe58a;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.8rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 4.8vw, 4.6rem);
		line-height: 0.95;
		letter-spacing: -0.07em;
		text-wrap: balance;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}

	.feature-card {
		position: relative;
		min-height: 300px;
		padding: 24px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 32px;
		background:
			linear-gradient(180deg, rgba(255, 248, 223, 0.12), rgba(255, 248, 223, 0.045)),
			rgba(5, 19, 33, 0.62);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
		overflow: hidden;
	}

	.feature-card::after {
		content: "";
		position: absolute;
		inset: auto -20% -35% -20%;
		height: 140px;
		background: radial-gradient(ellipse, rgba(255, 183, 58, 0.32), transparent 70%);
	}

	.icon {
		display: grid;
		place-items: center;
		width: 58px;
		height: 58px;
		border-radius: 20px;
		background: rgba(255, 248, 223, 0.13);
		font-size: 1.7rem;
	}

	h3 {
		margin: 54px 0 12px;
		font-size: 1.32rem;
		line-height: 1.08;
		letter-spacing: -0.04em;
	}

	p:not(.kicker) {
		margin: 0;
		color: rgba(255, 248, 223, 0.68);
		line-height: 1.62;
	}

	@media (max-width: 980px) {
		.section-heading {
			grid-template-columns: 1fr;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.features {
			padding-inline: 14px;
			padding-top: 82px;
		}

		.grid {
			grid-template-columns: 1fr;
		}

		.feature-card {
			min-height: 250px;
		}
	}
</style>
