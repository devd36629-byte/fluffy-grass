---
import { withBase } from '../lib/paths';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Endless Summer Simulator',
	description = 'Indoor fake beaches in Helsinki blasting 24-hour sunlight and tropical heat through the winter.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--ess-lagoon: #C1EBE9;
		--ess-sand: #FFF7C5;
		--ess-sun: #F4AE52;
		--ess-plum: #4F252E;
		--ess-lagoon-rgb: 193, 235, 233;
		--ess-sand-rgb: 255, 247, 197;
		--ess-sun-rgb: 244, 174, 82;
		--ess-plum-rgb: 79, 37, 46;

		--color-background: var(--ess-lagoon);
		--color-background-warm: var(--ess-sand);
		--color-surface: rgba(var(--ess-sand-rgb), 0.78);
		--color-surface-strong: var(--ess-sand);
		--color-surface-cool: rgba(var(--ess-lagoon-rgb), 0.72);
		--color-accent: var(--ess-sun);
		--color-accent-soft: rgba(var(--ess-sun-rgb), 0.18);
		--color-ink: var(--ess-plum);
		--color-ink-muted: rgba(var(--ess-plum-rgb), 0.72);
		--color-ink-soft: rgba(var(--ess-plum-rgb), 0.12);
		--color-on-accent: var(--ess-plum);
		--color-on-dark: var(--ess-sand);
		--color-border: rgba(var(--ess-plum-rgb), 0.16);
		--color-border-light: rgba(var(--ess-sand-rgb), 0.35);
		--shadow-soft: 0 24px 80px rgba(var(--ess-plum-rgb), 0.16);
		--shadow-warm: 0 30px 90px rgba(var(--ess-sun-rgb), 0.28);
		--gradient-page: radial-gradient(circle at 12% 8%, rgba(var(--ess-sand-rgb), 0.95), transparent 24rem),
			radial-gradient(circle at 86% 14%, rgba(var(--ess-sun-rgb), 0.5), transparent 27rem),
			linear-gradient(135deg, var(--ess-lagoon) 0%, var(--ess-lagoon) 34%, var(--ess-sand) 68%, rgba(var(--ess-sun-rgb), 0.82) 100%);
		--gradient-heat: linear-gradient(135deg, var(--ess-sand), var(--ess-sun) 68%, var(--ess-plum));

		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: var(--color-background);
		color: var(--color-ink);
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	* {
		box-sizing: border-box;
	}

	html {
		margin: 0;
		min-width: 320px;
		scroll-behavior: smooth;
		background: var(--gradient-page);
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--gradient-page);
		overflow-x: hidden;
	}

	a {
		color: inherit;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	::selection {
		background: rgba(var(--ess-sun-rgb), 0.55);
		color: var(--color-ink);
	}
</style>
